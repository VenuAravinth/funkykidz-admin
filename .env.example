# Copy to .env (development) or set in your host's environment settings. NEVER commit real values.

# FunkyKidz ERP Backend this admin panel talks to, and one of the backend's ERP_API_KEYS.
ERP_API_URL=http://localhost:4000
ERP_API_KEY=

# Signs the login session and 2FA cookies (required; at least 32 characters). Keep it stable:
# if it's missing or changes, every saved login ("Remember me" included) stops working.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Email (SMTP) for sign-in verification codes. Set these in .env locally AND in your host's
# environment settings for the deployed site. Without MAIL_HOST, development prints codes to the
# server console instead of sending them; production refuses to send.
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
# true = TLS from the start (port 465). false = STARTTLS (port 587), which is then required.
MAIL_SECURE=false
MAIL_USERNAME=
MAIL_PASSWORD=
# Sender shown on the emails. Must be an address your mail provider has verified
# (Brevo → Senders, Domains & Dedicated IPs). Example: "Funky Kids <no-reply@funkykidzz.com>"
MAIL_FROM=
