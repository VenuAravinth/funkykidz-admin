# Copy to .env (development) or set in your host's environment settings. NEVER commit real values.

# FunkyKidz ERP Backend this admin panel talks to, and one of the backend's ERP_API_KEYS.
ERP_API_URL=http://localhost:4000
ERP_API_KEY=

# Signs the login session and 2FA cookies (required; at least 32 characters). Keep it stable:
# if it's missing or changes, every saved login ("Remember me" included) stops working.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Email (SMTP) for sign-in and 2FA codes.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
